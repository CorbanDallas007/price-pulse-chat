# stealth-price-chat environment variables

# Режим работы браузера Camoufox: true — без окна, false — с окном (для ручного прохождения капчи)
HEADLESS_MODE=true

# Список прокси через запятую (поддерживаются HTTP и SOCKS5)
# Пример: http://user:pass@host:port, socks5://user:pass@host:port
PROXY_LIST=

# Таймаут HTTP-запросов в секундах
REQUEST_TIMEOUT=15

# Максимальное количество попыток повтора при 429/403
MAX_RETRIES=3

# TTL кэша поисковых запросов в секундах (15 минут)
CACHE_TTL_SECONDS=900

# Время карантина забаненного прокси в минутах
PROXY_BAN_MINUTES=10

# Порт сервера
PORT=8000
